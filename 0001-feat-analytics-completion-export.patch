+      /* ================================================ ANALYTICS: KALKULASI COMPLETION + EXPORT JSON (Fase 4) ================================================ */
+      function calculateCompletionStats() {
+        const counts = { earned: 0, progress: 0, available: 0, legacy: 0 };
+        let earnedScore = 0;
+        ACHIEVEMENTS.forEach((a) => {
+          counts[a.status] = (counts[a.status] || 0) + 1;
+          if (a.status === "earned") {
+            earnedScore += 1;
+          } else if (a.status === "progress" && a.prog && a.prog.max) {
+            earnedScore += Math.min(1, a.prog.cur / a.prog.max);
+          }
+        });
+        const total = ACHIEVEMENTS.length;
+        const percent = total ? (earnedScore / total) * 100 : 0;
+        return { counts, total, percent };
+      }
+
+      function renderAnalyticsPanel() {
+        const fill = document.getElementById("analyticsBarFill");
+        const label = document.getElementById("analyticsPercentLabel");
+        const breakdown = document.getElementById("analyticsBreakdown");
+        if (!fill || !label || !breakdown) return;
+
+        const { counts, percent } = calculateCompletionStats();
+        fill.style.width = `${percent.toFixed(1)}%`;
+        label.textContent = `${percent.toFixed(1)}%`;
+        fill.parentElement.setAttribute("role", "progressbar");
+        fill.parentElement.setAttribute("aria-valuemin", "0");
+        fill.parentElement.setAttribute("aria-valuemax", "100");
+        fill.parentElement.setAttribute(
+          "aria-valuenow",
+          percent.toFixed(1),
+        );
+
+        const items = [
+          { key: "earned", label: "Earned" },
+          { key: "progress", label: "In Progress" },
+          { key: "available", label: "Available" },
+          { key: "legacy", label: "Legacy" },
+        ];
+        breakdown.innerHTML = items
+          .map(
+            (i) => `
+        <div class="analytics-stat">
+          <div class="analytics-stat-val ${i.key}">${counts[i.key] || 0}</div>
+          <div class="analytics-stat-label">${i.label}</div>
+        </div>`,
+          )
+          .join("");
+      }
+
+      function exportAchievementsJSON() {
+        const { counts, total, percent } = calculateCompletionStats();
+        const payload = {
+          generatedAt: new Date().toISOString(),
+          source: "AchievementForge",
+          totalAchievements: total,
+          completionPercent: Number(percent.toFixed(1)),
+          breakdown: counts,
+          achievements: ACHIEVEMENTS.map((a) => ({
+            name: a.name,
+            status: a.status,
+            description: a.desc,
+            strategy: a.strategy,
+            progress: a.prog
+              ? { current: a.prog.cur, target: a.prog.max }
+              : null,
+          })),
+        };
+        const blob = new Blob([JSON.stringify(payload, null, 2)], {
+          type: "application/json",
+        });
+        const url = URL.createObjectURL(blob);
+        const link = document.createElement("a");
+        link.href = url;
+        link.download = "achievementforge-data.json";
+        document.body.appendChild(link);
+        link.click();
+        link.remove();
+        URL.revokeObjectURL(url);
+      }
+
+      function initAnalyticsExport() {
+        const btn = document.getElementById("exportJsonBtn");
+        if (!btn) return;
+        btn.addEventListener("click", exportAchievementsJSON);
+      }
+
